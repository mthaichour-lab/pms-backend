{
  "name": "pms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "contracts:lint": "node contracts/scripts/validate-contracts.mjs",
    "contracts:generate-sdk": "node contracts/scripts/generate-sdk.mjs",
    "contracts:check-sdk": "node contracts/scripts/generate-sdk.mjs --check && node contracts/scripts/verify-sdk-coverage.mjs",
    "database:verify": "node database/verification/verify-foundation.mjs",
    "database:verify-seeds": "node database/verification/verify-seeds.mjs",
    "token-vault:verify": "node apps/tokenization-service/database/verification/verify-vault.mjs",
    "deploy:verify": "node deploy/verification/verify-runtime.mjs",
    "e2e:smoke": "node tests/e2e/api-runtime-smoke.mjs",
    "e2e:real": "docker compose --env-file .env.local -f compose.yaml -f compose.local.yaml -f compose.e2e.yaml --profile local-seed up --build --abort-on-container-exit --exit-code-from e2e e2e",
    "e2e:real:down": "docker compose --env-file .env.local -f compose.yaml -f compose.local.yaml -f compose.e2e.yaml --profile local-seed down --volumes --remove-orphans",
    "sdk:build": "tsc -p packages/pms-api-client/tsconfig.lib.json",
    "sdk:pack": "pnpm run sdk:build && pnpm --filter @bank/pms-api-client pack",
    "build": "tsc -p tsconfig.build.json && pnpm run sdk:build",
    "start": "node dist/apps/api/src/main.js",
    "start:calculation-worker": "node dist/apps/calculation-worker/src/main.js",
    "start:ingestion-worker": "node dist/apps/ingestion-worker/src/main.js",
    "start:closing-worker": "node dist/apps/closing-worker/src/main.js",
    "start:document-worker": "node dist/apps/document-worker/src/main.js",
    "start:audit-worker": "node dist/apps/audit-worker/src/main.js",
    "start:scheduler": "node dist/apps/scheduler/src/main.js",
    "start:db-migrate": "node dist/apps/db-migrate/src/main.js",
    "start:db-seed": "node dist/apps/db-seed/src/main.js",
    "start:queue-scaler": "node deploy/autoscaling/queue-depth-scaler.mjs",
    "performance:million": "node performance/million-account-calculation.mjs",
    "dr:exercise": "node deploy/dr/run-failover-drill.mjs",
    "dr:verify": "node deploy/dr/verify-failover-evidence.mjs",
    "pentest:gate": "node security/pentest/evaluate-pentest.mjs",
    "pentest:verify-fixture": "node security/pentest/verify-gate-fixture.mjs",
    "parallel-run:gate": "node homologation/parallel-run/evaluate-parallel-run.mjs",
    "parallel-run:verify-fixture": "node homologation/parallel-run/verify-fixture.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.221.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "amqplib": "2.0.1",
    "decimal.js": "^10.6.0",
    "jose": "6.2.10",
    "pg": "8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  }
}
